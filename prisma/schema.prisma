generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum VerificationLevel {
  UNVERIFIED
  BASIC
  VERIFIED
  HIGH
}

enum SwipeDirection {
  LEFT
  RIGHT
  SUPER
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
  BLOCKED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  SYSTEM
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  MATCHES_ONLY
}

enum UserStatus {
  ACTIVE
  BANNED
  PENDING
  SUSPENDED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// Core Models
model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  roles              String[]            @default([]) // RBAC roles
  verificationLevel  VerificationLevel   @default(UNVERIFIED)
  createdAt          DateTime            @default(now())
  lastActiveAt       DateTime?
  deletedAt          DateTime?

  // Relations
  profile            Profile?
  preferences        Preferences?
  location           Location?
  swipes             Swipe[]             @relation("UserSwipes")
  swipedBy           Swipe[]             @relation("TargetSwipes")
  matchesA           Match[]             @relation("MatchesA")
  matchesB           Match[]             @relation("MatchesB")
  messages           Message[]
  reports            Report[]            @relation("ReportedUser")
  reportedBy         Report[]            @relation("ReportedBy")
  moderationItems    ModerationItem[]    @relation("ModerationUser")
  moderationReports  ModerationItem[]    @relation("ModerationReporter")

  @@index([email])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([roles])
  @@index([verificationLevel])
}

model Profile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  age           Int
  gender        String?
  orientation   String?
  bio           String?
  interests     String[] @default([])
  lifestyle     Json?
  education     String?
  photos        String[] @default([])
  videoIntroUrl String?
  prompts       String[] @default([])
  visibility    ProfileVisibility @default(PUBLIC)
  status        UserStatus @default(ACTIVE)
  isAdmin       Boolean @default(false)
  verified      Boolean @default(false)

  @@index([age])
  @@index([gender])
  @@index([visibility])
  @@index([status])
  @@index([age, gender])
  @@index([gender, visibility])
  @@index([age, gender, visibility])
  @@index([visibility, status])
}

model Preferences {
  userId          String @id
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  minAge          Int    @default(18)
  maxAge          Int    @default(55)
  distanceKm      Int    @default(50)
  showMe          String? // e.g., gender filter
  advancedFilters Json?
}

model Location {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
}

model Swipe {
  id           String         @id @default(uuid())
  userId       String
  targetUserId String
  direction    SwipeDirection
  createdAt    DateTime       @default(now())

  user         User           @relation("UserSwipes", fields: [userId], references: [id], onDelete: Cascade)
  targetUser   User           @relation("TargetSwipes", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([targetUserId, createdAt])
}

model Match {
  id        String       @id @default(uuid())
  userIdA   String
  userIdB   String
  createdAt DateTime     @default(now())
  status    MatchStatus  @default(ACTIVE)
  reason    String?

  userA     User         @relation("MatchesA", fields: [userIdA], references: [id], onDelete: Cascade)
  userB     User         @relation("MatchesB", fields: [userIdB], references: [id], onDelete: Cascade)
  convo     Conversation?

  @@unique([userIdA, userIdB])
  @@index([userIdA, createdAt])
  @@index([userIdB, createdAt])
}

model Conversation {
  id            String   @id @default(uuid())
  matchId       String   @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime?

  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  content        String?
  mediaUrls      String[]     @default([])
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([readAt])
  @@index([senderId, readAt])
  @@index([conversationId, readAt])
}

model Report {
  id             String       @id @default(uuid())
  reportedUserId String
  reportedById   String
  reason         String
  description    String?
  status         ReportStatus @default(PENDING)
  priority       ModerationPriority @default(MEDIUM)
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?

  reportedUser   User         @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedBy     User         @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model ModerationItem {
  id           String             @id @default(uuid())
  type         String             // PHOTO, PROFILE, MESSAGE, etc.
  userId       String
  content      String
  reason       String
  priority     ModerationPriority @default(MEDIUM)
  status       ModerationStatus   @default(PENDING)
  submittedAt  DateTime           @default(now())
  reportedById String?
  reviewedAt   DateTime?
  reviewedBy   String?

  user         User               @relation("ModerationUser", fields: [userId], references: [id], onDelete: Cascade)
  reportedBy   User?              @relation("ModerationReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([submittedAt])
  @@index([type])
}

// Content Management Models
model FeatureFlag {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  description       String?
  enabled           Boolean  @default(false)
  targetAudience    String   @default("all") // 'all', 'premium', 'beta'
  rolloutPercentage Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([enabled])
  @@index([targetAudience])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  subject     String
  htmlContent String
  textContent String?
  variables   Json     @default("[]")
  category    String   @default("notification") // 'auth', 'notification', 'marketing'
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([enabled])
}

model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  category    String   @default("general") // 'general', 'branding', 'limits', 'matching', 'notifications'
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

model ContentPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String
  metaDescription String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published])
}
