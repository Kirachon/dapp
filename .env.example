# API
PORT=8080

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGEME_DEV_ONLY
POSTGRES_DB=dating
DATABASE_URL=postgres://app:app@postgres:5432/dating

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME_DEV_ONLY
S3_ENDPOINT=http://minio:9000
S3_BUCKET=media

# MailHog
SMTP_HOST=mailhog
SMTP_PORT=1025

# SuperTokens
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=CHANGEME_DEV_ONLY

# Security Configuration
# SECURITY WARNING: Never set ALLOW_MOCK_AUTH=true in production
# Mock auth endpoints are disabled by default in production for security
ALLOW_MOCK_AUTH=false

# CORS Configuration
# In production, set specific allowed origins instead of allowing all
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Content Security Policy Configuration
# Set to true to enable CSP report-only mode for testing
CSP_REPORT_ONLY=false

# GraphQL limits (defense-in-depth)
GRAPHQL_MAX_COMPLEXITY=300
GRAPHQL_MAX_DEPTH=10

# Frontend/Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080/graphql

# Admin IP allowlist (comma-separated). In production, required; otherwise admin APIs are denied by default.
ADMIN_IP_WHITELIST=127.0.0.1

